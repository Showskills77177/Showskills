{
  "name": "showskills",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node scripts/kill-port.mjs 3000 && node server.js",
    "dev:all": "node scripts/kill-port.mjs 3000 && concurrently -k \"npm run dev\" \"node scripts/kill-port.mjs 3000 && node server.js\"",
    "dev:integration": "node scripts/dev-cashflows-integration.mjs",
    "cashflows:test-gateway": "node scripts/test-cashflows-gateway.mjs",
    "cashflows:probe": "node scripts/probe-cashflows-gateway.mjs",
    "cashflows:test-free-api": "node scripts/test-cashflows-free-local.mjs",
    "dev:e2e": "concurrently -k \"PORT=3001 SQLITE_PATH=db/e2e.sqlite E2E_MODE=1 node server.js\" \"VITE_PROXY_API_TARGET=http://127.0.0.1:3001 vite --port 5173 --strictPort\"",
    "i18n:build": "node scripts/build-i18n-catalog.mjs",
    "i18n:translate": "node scripts/generate-site-translations.mjs",
    "i18n:sync": "node scripts/build-i18n-catalog.mjs && node scripts/generate-site-translations.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "guard": "node code-guardian.js",
    "guard:quick": "node code-guardian.js --quick",
    "guard:full": "node code-guardian.js --e2e",
    "guard:e2e": "GUARDIAN_E2E=1 node code-guardian.js --e2e",
    "preview": "vite preview",
    "db:setup": "node db/setup.js",
    "db:schema": "node db/schema.js",
    "seed:kickup": "node scripts/seed-kickup-video.mjs",
    "seed:draw-pool": "node scripts/seed-draw-pool.mjs",
    "seed:draw-pool:200": "node scripts/seed-draw-pool.mjs 200 --clear",
    "seed:period-split": "node scripts/seed-period-split-test.mjs",
    "seed:test3-bulk": "node scripts/seed-ronaldo-bundle-test3-bulk.mjs 334 --clear",
    "preview:winner-email": "node scripts/preview-winner-email.mjs",
    "preview:world-cup-ball-winner-email": "node scripts/preview-world-cup-ball-winner-email.mjs",
    "generate:quiz-voiceover": "node scripts/generate-quiz-voiceover.mjs",
    "test:period-split": "node scripts/test-period-split-draw.mjs",
    "test:draw-local": "node scripts/test-draw-local.mjs",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:admin": "playwright test tests/e2e/admin.spec.js",
    "test:eof": "playwright test tests/e2e/eyes-of-football.spec.js",
    "test:eyes-of-football": "node scripts/test-eyes-of-football-api.mjs && playwright test tests/e2e/eyes-of-football.spec.js",
    "test:eof-production": "node --test shared/eofScriptTemplates.test.mjs shared/eofSceneAdapt.test.mjs shared/eofProduction.test.mjs shared/eofPinterestImages.test.mjs shared/eofGoogleImages.test.mjs shared/eofOxylabsImages.test.mjs shared/eofSerpApiImages.test.mjs shared/eofImageProviderSettings.test.mjs shared/eofImageGen.test.mjs shared/eofImageVision.test.mjs shared/eofSceneImageQueries.test.mjs shared/eofCaptionRender.test.mjs shared/eofCaptionLayout.test.mjs shared/eofCaptionStyles.test.mjs shared/eofVideoDiskSource.test.mjs shared/eofStockImageFilter.test.mjs shared/eofOverlayMoments.test.mjs shared/eofVideoEffects.test.mjs shared/eofStickersElements.test.mjs && node scripts/test-eof-production-api.mjs && node scripts/test-eof-video-pipeline.mjs",
    "render:eof": "node scripts/render-eof-production.mjs",
    "seed:eof-music": "node scripts/seed-eof-music-catalog.mjs",
    "test:payment": "playwright test tests/e2e/payment-mocked.spec.js",
    "test:quiz": "node --test shared/paidSkillQuestions.test.mjs shared/competitionSkillQuestions.test.mjs shared/vpnDetection.test.mjs shared/competitionPeriods.test.mjs shared/competitionCopy.test.mjs shared/consolationShirtGiveaway.test.mjs",
    "test:email-templates": "node --test shared/emailTemplates.test.mjs shared/siteContact.test.mjs shared/stagingSite.test.mjs",
    "test:stress": "playwright test tests/e2e/quiz-session-stress.spec.js tests/e2e/payment-mocked.spec.js tests/e2e/edge-cases.spec.js tests/e2e/contact.spec.js",
    "test:ui": "playwright test --ui",
    "test:install": "playwright install chromium",
    "test:install:browsers": "playwright install chromium firefox webkit",
    "test:payment:cross-browser": "playwright test tests/e2e/payment-cross-browser.spec.js",
    "test:cross-browser": "playwright test tests/e2e/checkout-ux.spec.js tests/e2e/payment-cross-browser.spec.js --project=chromium-checkout-ux --project=firefox-checkout-ux --project=webkit-checkout-ux --project=mobile-chrome-checkout-ux --project=mobile-safari-checkout-ux --project=firefox-payment --project=webkit-payment --project=mobile-chrome-payment --project=mobile-safari-payment",
    "test:purchase-email": "node scripts/test-purchase-email.mjs",
    "test:consolation-shirt": "node scripts/test-consolation-shirt.mjs",
    "test:competition-catalog": "node scripts/test-competition-catalog.mjs",
    "test:user-account": "node scripts/test-user-account-api.mjs",
    "test:world-cup-ball": "node scripts/test-world-cup-ball-api.mjs",
    "test:world-cup-ball-monthly-draw": "node scripts/test-world-cup-ball-monthly-draw.mjs",
    "reset:world-cup-ball": "node scripts/reset-world-cup-ball-local.mjs",
    "test:admin-email": "node scripts/test-admin-otp-email.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.7.5",
    "altcha": "^3.1.0",
    "altcha-lib": "^2.2.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "cashflows-clientlib-js": "^1.0.51",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jose": "^5.10.0",
    "lucide-react": "^1.16.0",
    "multer": "^1.4.5-lts.2",
    "node-edge-tts": "^1.2.10",
    "pg": "^8.14.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.1"
  }
}
