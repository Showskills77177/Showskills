# Card payments — Cashflows Embedded Checkout (see archive/stripe/ for legacy Stripe code).
# Ticket totals are fixed bundles in shared/ticketBundles.mjs (not env).
# Optional: pre-select a bundle in the entry modal (e.g. single, medium10).
# VITE_DEFAULT_BUNDLE_ID=single
#
# Optional: lock API CORS to your site (comma-separated origins, no trailing slash)
# ALLOWED_ORIGINS=https://showskills.co.uk,https://www.showskills.co.uk
# Or single: SITE_URL=https://showskills.co.uk
#
# Full security notes: docs/SECURITY.md
# Production: HTTPS only, never set E2E_MODE=1, use ADMIN_PASSWORD_HASH.
# Optional: HMAC secret for timed post-purchase bundle preview image URLs (defaults to ADMIN_SESSION_SECRET).
# PRIZE_REVEAL_SECRET=

# Cashflows Embedded Checkout (card fields in iframe on your site — not hosted redirect).
# Get Configuration ID + API key from Cashflows Portal → Configuration → API Data.
# Use integration credentials with CASHFLOWS_INTEGRATION=1 until go-live.
CASHFLOWS_CONFIGURATION_ID=
CASHFLOWS_API_KEY=
CASHFLOWS_INTEGRATION=1
# CASHFLOWS_CURRENCY=GBP
# Webhook URL: https://YOUR_DOMAIN/api/cashflows-webhook (whitelist Cashflows IPs — see docs/SECURITY.md)
# Optional in production (defaults on). Required for local dev unless you set PROD build.
VITE_CASHFLOWS_ENABLED=1
# VITE_CASHFLOWS_CREATE_INTENT_URL=
# Google Pay (embedded checkout) — Merchant ID from Google Pay Business Console after Cashflows enables Google Pay in the portal.
# CASHFLOWS_GOOGLE_PAY_MERCHANT_ID=
# VITE_CASHFLOWS_GOOGLE_MERCHANT_ID=

# PayPal (optional second processor) — bundle totals match shared/ticketBundles.mjs.
# Create a REST app in PayPal Developer (Sandbox or Live). Server secrets never use VITE_.
VITE_PAYPAL_CLIENT_ID=
# Must match purchase currency (PayPal uses uppercase, e.g. GBP)
# VITE_PAYPAL_CURRENCY=GBP
# Optional: override API paths (defaults: {BASE_URL}/api/create-paypal-order and capture-paypal-order)
# VITE_PAYPAL_CREATE_ORDER_URL=
# VITE_PAYPAL_CAPTURE_ORDER_URL=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live
# PAYPAL_MODE=sandbox
# Optional explicit API host (otherwise derived from PAYPAL_MODE)
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# PAYPAL_UNIT_AMOUNT_PENCE is unused; order amount comes from the selected bundle server-side.
# PAYPAL_UNIT_AMOUNT_PENCE=100
# PAYPAL_CURRENCY=GBP

# Local dev: `npm run dev:all` (Vite + Express `server.js` on :3000), or `npm run dev:api` + `npm run dev`.
# Test API: curl -X POST http://localhost:3000/api/login -H 'Content-Type: application/json' -d '{"username":"admin","password":"admin"}'
# If the API is on another host/port, set e.g. VITE_PROXY_API_TARGET=http://127.0.0.1:3001
# Do not set VITE_API_BASE for normal local dev — the app uses same-origin /api and Vite proxies to :3000.
# Setting VITE_API_BASE=http://127.0.0.1:3000 while opening the site on localhost causes CORS / “Network error”.
# Override proxy target only in vite.config.js (VITE_PROXY_API_TARGET). For rare direct API calls: VITE_DEV_DIRECT_API=true
# PayPal APIs work the same way under `vercel dev` when PAYPAL_* secrets are set.

# Database — use ONE of:
# A) Local SQLite (default for `npm run dev:api`): npm run db:setup && npm run db:schema
SQLITE_PATH=db/db.sqlite
# B) Hosted Postgres (e.g. Vercel/Neon): set DATABASE_URL or use Neon’s POSTGRES_URL; leave SQLITE_PATH unset
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# POSTGRES_URL=postgresql://...  (Neon on Vercel sets this automatically)

# Purchase + admin OTP emails (Resend — https://resend.com, domain showskills.co.uk)
# Production (Vercel): RESEND_API_KEY + ADMIN_EMAIL + SITE_URL (defaults below if omitted)
RESEND_API_KEY=
# Newsletter welcome email on signup (set to 0 to disable)
# NEWSLETTER_SEND_WELCOME=1
# Secret for unsubscribe/preference links (defaults to ADMIN_SESSION_SECRET)
# NEWSLETTER_TOKEN_SECRET=
# PURCHASE_EMAIL_FROM=ShowSkills Rewards <orders@showskills.co.uk>
# CONTACT_EMAIL_TO=contact@showskills.co.uk
# Local dev with verified showskills.co.uk on Resend (send to any address from localhost):
# RESEND_USE_VERIFIED_DOMAIN=1
# PURCHASE_EMAIL_FROM=ShowSkills Rewards <orders@showskills.co.uk>
# Without the above, local API uses onboarding@resend.dev and only delivers to RESEND_ACCOUNT_EMAIL.

# Trustpilot TrustBox (defaults in shared/trustpilotConfig.mjs — override if needed)
# VITE_TRUSTPILOT_BUSINESS_UNIT_ID=6a0ede24b5e8fbc1fc6ac5b7
# VITE_TRUSTPILOT_REVIEW_URL=https://www.trustpilot.com/review/showskills.co.uk
# Local dev site origin (quiz links, etc.). Emails use https://showskills.co.uk for logo/images unless overridden:
# SITE_URL=http://localhost:5173
# EMAIL_PUBLIC_SITE_URL=https://showskills.co.uk
# Local Resend test inbox (when RESEND_USE_VERIFIED_DOMAIN is not set): RESEND_ACCOUNT_EMAIL=your-resend-signup@email.com

# Admin 2FA — password + 6-digit email (Resend) on Vercel Production only.
# Local `npm run dev:all` skips email codes automatically (no VERCEL env).
# ADMIN_REQUIRE_EMAIL_OTP=1  — force email codes even locally
# ADMIN_SKIP_EMAIL_OTP=1     — skip codes on Vercel preview/dev (not production)
# ADMIN_EMAIL=you@showskills.co.uk
# Resend free tier: https://resend.com (3,000 emails/month)

# Admin panel (/admin) — never commit real values
ADMIN_USER=admin
# Plain password (dev) or bcrypt hash (recommended prod): ADMIN_PASSWORD_HASH=$2a$...
# Quote if the password contains # or leading special characters, e.g. ADMIN_PASSWORD=":admin"
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
# Min 32 characters; used to sign HttpOnly session cookie
ADMIN_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Optional separate secret for public user accounts (falls back to ADMIN_JWT_SECRET)
# USER_JWT_SECRET=
# Password reset security question (answer is checked before email reset code is sent)
# ADMIN_RESET_SECRET_QUESTION=What city were you born in?
ADMIN_RESET_SECRET_ANSWER=

# AI copy assistant in Admin → Competitions (OpenAI / ChatGPT)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Shirt giveaway: VPN/proxy detection on submit (and GET /api/vpn-check when the modal opens).
# Production: set IPHUB_API_KEY (https://iphub.info — free tier ~1000 lookups/day) for reliable VPN blocking.
# Without a key, ip-api.com is used (proxy/hosting flags; less accurate). Local/E2E: VPN_CHECK_DISABLED=1 or E2E_MODE=1.
# IPHUB_API_KEY=
# VPN_CHECK_DISABLED=1

# Self-hosted ALTCHA CAPTCHA (World Cup Ball quiz start) — free, no Cloudflare/Google signup.
# Uses ALTCHA_HMAC_KEY if set, otherwise ADMIN_JWT_SECRET (already required for admin).
# Disabled when E2E_MODE=1. Optional override: CAPTCHA_SKIP=1
# ALTCHA_HMAC_KEY=
#
# Quiz timer voiceover clips live in public/audio/quiz/ (Microsoft Edge neural TTS).
# Regenerate: npm run generate:quiz-voiceover
# Optional voice override: QUIZ_VOICEOVER_VOICE=en-GB-RyanNeural

# Kick-up video uploads: Vercel has no persistent disk. Run the multipart upload API on a small VPS / Fly.io / Render
# (same repo `server.js` or a minimal fork) and point the frontend at that host, or switch to S3-compatible storage
# (Cloudflare R2, Backblaze B2, Wasabi) and store public or signed https URLs in `video_ref` instead of `local:…`.
# Local dev writes to ./uploads/kickups; admin delete removes the DB row and that file when `video_ref` is local.

# Eyes Of Football — YouTube Shorts hub (staging only: /admin/eyes-of-football)
# 1) Google Cloud → enable YouTube Data API v3 → OAuth Web client
# 2) Add redirect URI shown on the admin page to Authorized redirect URIs
# 3) Connect channel once → stores refresh token server-side (editors never get YouTube login)
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=
# YOUTUBE_CHANNEL_ID=
# YOUTUBE_REDIRECT_URI=https://your-staging-host.example/api/youtube-oauth-callback
# Optional editor login (staging Eyes Of Football — separate from ADMIN_USER):
# EOF_EDITOR_USER=editor
# EOF_EDITOR_PASSWORD=
#
# EOF auto-production: place YouTube Audio Library MP3s in public/eof/music/
# then npm run seed:eof-music or register in admin → Music.
# Reconnect YouTube after enabling Analytics API to grant yt-analytics.readonly scope.
