# Cashflows SANDBOX — separate from live keys in .env.local
# Portal: https://secure-int.cashflows.com/  (Configuration → API Data)
# If you only have live credentials, email implementations@cashflows.com for an integration account.
#
# Copy:  cp .env.integration.local.example .env.integration.local
# Run:   npm run dev:integration

CASHFLOWS_CONFIGURATION_ID=
CASHFLOWS_API_KEY=
CASHFLOWS_INTEGRATION=1
VITE_CASHFLOWS_ENABLED=1
