{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/[[...slug]].js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/{harfbuzzjs,@resvg,@img,sharp}/**"
    },
    "api/admin/[...slug].js": {
      "includeFiles": "node_modules/{harfbuzzjs,@resvg,@img,sharp}/**"
    },
    "api/submissions/[...slug].js": {
      "includeFiles": "node_modules/{harfbuzzjs,@resvg,@img,sharp}/**"
    },
    "api/submissions/world-cup-ball/[...slug].js": {
      "includeFiles": "node_modules/{harfbuzzjs,@resvg,@img,sharp}/**"
    },
    "api/submissions/ronaldo-shirt-quiz/[...slug].js": {
      "includeFiles": "node_modules/{harfbuzzjs,@resvg,@img,sharp}/**"
    },
    "api/analytics/[...slug].js": {
      "includeFiles": "node_modules/{harfbuzzjs,@resvg,@img,sharp}/**"
    },
    "api/auth/[...slug].js": {
      "includeFiles": "node_modules/{harfbuzzjs,@resvg,@img,sharp}/**"
    },
    "api/entries/[...slug].js": {
      "includeFiles": "node_modules/{harfbuzzjs,@resvg,@img,sharp}/**"
    },
    "api/newsletter/[...slug].js": {
      "includeFiles": "node_modules/{harfbuzzjs,@resvg,@img,sharp}/**"
    },
    "api/visitor/[...slug].js": {
      "includeFiles": "node_modules/{harfbuzzjs,@resvg,@img,sharp}/**"
    }
  },
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/.well-known/apple-developer-merchantid-domain-association",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/)(?!\\.well-known/)(?!.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
